# Copy this file to .env and fill in real values. NEVER commit .env.

# Your Gemini API key (free tier is fine). Read from env only, never hardcoded.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for classification and chat phrasing.
GEMINI_MODEL=gemini-1.5-flash

# Database URL.
# Local dev (default if unset): SQLite file next to the app.
#   sqlite:///./app.db
# Production (Supabase / any Postgres): use the connection string from your provider.
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of allowed CORS origins for your deployed frontend.
# Use * for local dev; set your real Vercel URL in production.
CORS_ORIGINS=*
